# Populate in the hosting secret manager; never commit a filled secret file.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=https://racing-escrow-engine.vercel.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public publishable/anon key only. Server role keys are rejected here.
SUPABASE_PUBLISHABLE_KEY=
RACING_TENANT_ID=
CRON_SECRET=
# JSON keyrings: [{"key_id":"...","tenant_id":"uuid","provider_id":"uuid","secret_base64":"random >=32 bytes, base64"}]
TELEMETRY_KEYS_JSON=[]
DISCORD_BROKER_KEYS_JSON=[]
# Must reflect explicit merchant authorization for this exact business model.
COMMERCE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=
# Exact comma-separated download hosts confirmed by your provider integration.
IRACING_DOWNLOAD_HOSTS=
OAUTH_ENCRYPTION_KEY=
# Supabase auth user ID of the authorized service account connected through OAuth.
IRACING_OPERATOR_AUTH_USER_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_BROKER_KEY_ID=
DISCORD_BROKER_SECRET_BASE64=
BACKEND_API_BASE_URL=https://racing-escrow-engine.vercel.app
# Dedicated ACC host only. Server keyring must map this key ID to that provider.
ACC_PROVIDER_KEY_ID=
ACC_PROVIDER_SECRET_BASE64=

# Exact additional HTTPS origins only; same-origin dashboard needs no CORS list.
CORS_ALLOWED_ORIGINS=
# Enable after configuring authenticated private Realtime and disabling public access.
REALTIME_ENABLED=false
# Distinct provider-role keyrings; never reuse a signing secret across roles.
COMPLIANCE_KEYS_JSON=[]
OPERATOR_KEYS_JSON=[]
# Only on a trusted provider/operator host for scripts/send-signed.js.
SIGNING_KEY_ID=
SIGNING_SECRET_BASE64=

# Optional standalone web process; managed hosts supply their own port.
PORT=3000

# Sumsub Production credentials; select a production individual verification
# level requiring government ID and address evidence. No sandbox identities.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=
# Exact hosted link domain returned by your Production Sumsub integration.
SUMSUB_WEBSDK_HOST=
