PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
# Public browser auth configuration (no service-role key here).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
RACING_TENANT_ID=11111111-1111-4111-8111-111111111111
# Optional HTTPS refund worker; generate >=32 random bytes. Never put in browser.
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Each provider key maps to one tenant/provider. Secret = >=32 random bytes, base64.
# Two key IDs can map to the same provider during key rotation.
TELEMETRY_KEYS_JSON=[{"key_id":"provider-key-1","tenant_id":"11111111-1111-4111-8111-111111111111","provider_id":"22222222-2222-4222-8222-222222222222","secret_base64":"REPLACE_WITH_BASE64_RANDOM_32_BYTES"}]
